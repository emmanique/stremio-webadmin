# Copy to .env if you need a local configuration file.
# Keep secrets out of Git; use WebAdmin or local secret storage for passwords/tokens.
#
# Host IPv4 is intentionally blank. `sh start.sh` / `sh start-vpn.sh` detect the
# current LAN IPv4 automatically. Override only when needed:
#   IPADDRESS=192.168.1.244 sh start.sh

# Published images. The default installation uses GHCR and does not build locally.
STREMIO_IMAGE=ghcr.io/emmanique/stremio-libtorrent-server-webadmin:latest
WEBADMIN_IMAGE=ghcr.io/emmanique/stremio-libtorrent-server-webadmin-webadmin:latest
VPN_IMAGE=ghcr.io/emmanique/stremio-libtorrent-server-webadmin-vpn:latest
STREMIO_PACKAGE_REPO=ghcr.io/emmanique/stremio-libtorrent-server-webadmin
STREMIO_SOURCE_REPO=https://github.com/emmanique/stremio-libtorrent-server-webadmin
STREMIO_SOURCE_BRANCH=main

# Host / Stremio
IPADDRESS=
SERVER_URL=
STREMIO_DATA_DIR=stremio-cache
STREMIOSRV_BT_LISTEN_PORT=6881
CERT_FILE=certificates.pem
STREMIO_UPDATE_HEALTH_TIMEOUT=180

# Stremio Cache / Library Addon
STREMIOSRV_LIBRARY_UI=true
STREMIOSRV_LIBRARY_ALLOW_HTTP=false
STREMIOSRV_LIBRARY_OWNER=
# Leave empty to accept the built-in private-network ranges.
STREMIOSRV_LIBRARY_ADDON_ALLOW=

# Transcoding baseline
TRANSCODING_MODE=auto
TRANSCODING_HWACCEL=vaapi
VAAPI_DEVICE=/dev/dri/renderD128
TRANSCODING_VIDEO_CODEC=h264_vaapi
TRANSCODING_VIDEO_QUALITY=22
TRANSCODING_AUDIO_CODEC=aac
TRANSCODING_AUDIO_BITRATE=192k
TRANSCODING_COPY_VIDEO=true
TRANSCODING_COPY_AUDIO=true
TRANSCODING_DIRECT_VIDEO_CODECS=h264
TRANSCODING_DIRECT_AUDIO_CODECS=aac,mp3,ac3
TRANSCODING_FALLBACK_CODEC=libx264
TRANSCODING_HW_DECODE=true

# CyberGhost / Gluetun VPN defaults.
# Do NOT put CyberGhost username, password, pre-shared value, certificates or
# private keys here. Create/import VPN connections in WebAdmin -> VPN.
# Do not include broad 10.0.0.0/8 here: CyberGhost may allocate 10.x tunnel
# addresses and overlapping outbound subnets can create conflicting routes.
VPN_LAN_CIDRS=192.168.0.0/16,172.30.0.0/24

# Pi-hole deployment values.
TZ=Africa/Luanda
PIHOLE_PASSWORD=
# start.sh/start-vpn.sh bind these to the detected host IPv4 unless explicitly overridden.
PIHOLE_WEB_BIND_IP=
PIHOLE_WEB_PORT=8053
PIHOLE_UPSTREAM_DNS=1.1.1.1;1.0.0.1
PIHOLE_DNS_BIND_IP=
PIHOLE_DNS_PORT=53

# Pi-hole optimization policy is intentionally NOT configurable here.
# The Stremio platform locks its FTL performance/security baseline in compose.yaml
# and compose.vpn.yaml using FTLCONF environment variables. Pi-hole v6 treats
# those settings as read-only in the Web UI, CLI and pihole.toml.
#
# Locked baseline:
# - dns-forward-max: 300
# - DNS cache: 10000 entries
# - cache optimizer: 3600 seconds
# - blocked-upstream cache TTL: 86400 seconds
# - domain-needed / bogus-private: enabled
# - DNSSEC: disabled (the VPN path uses the Gluetun secure resolver)
# - query logging: enabled
# - rate limit: 1000 queries / 60 seconds per client
# - blocking: enabled, NULL mode
# - query database retention: 30 days
# - database write interval: 60 seconds
# - SQLite WAL: enabled
#
# In VPN mode, the upstream is also locked to the private Gluetun DNS bridge
# (172.30.0.10#1053) to prevent accidental DNS egress outside the VPN path.
