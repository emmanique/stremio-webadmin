# Stremio Server WebAdmin - local deployment configuration
#
# Create the local file once:
#   cp .env.example .env
#
# Never commit .env. Keep passwords, VPN profiles, private keys and certificates
# outside Git. WebAdmin stores runtime configuration in Docker volumes.

# -----------------------------------------------------------------------------
# Published images
# -----------------------------------------------------------------------------
STREMIO_IMAGE=ghcr.io/emmanique/stremio-libtorrent-server-webadmin:latest
WEBADMIN_IMAGE=ghcr.io/emmanique/stremio-libtorrent-server-webadmin-webadmin:latest
VPN_IMAGE=ghcr.io/emmanique/stremio-libtorrent-server-webadmin-vpn:latest
STREMIO_PACKAGE_REPO=ghcr.io/emmanique/stremio-libtorrent-server-webadmin
STREMIO_SOURCE_REPO=https://github.com/emmanique/stremio-libtorrent-server-webadmin
STREMIO_SOURCE_BRANCH=main

# -----------------------------------------------------------------------------
# Host / networking
# -----------------------------------------------------------------------------
# Leave blank when using start.sh: the launcher detects and persists the host IPv4.
# Set manually on multi-homed hosts or when automatic detection chooses the wrong NIC.
IPADDRESS=
# auto = detect/refresh at each start; manual = use IPADDRESS above.
IPADDRESS_SOURCE=auto
SERVER_URL=
STREMIO_DATA_DIR=stremio-cache
STREMIOSRV_BT_LISTEN_PORT=6881
CERT_FILE=certificates.pem
STREMIO_UPDATE_HEALTH_TIMEOUT=180

# Time zone. Change to a valid IANA name, for example Europe/Lisbon or Africa/Luanda.
TZ=UTC

# -----------------------------------------------------------------------------
# Library Addon
# -----------------------------------------------------------------------------
STREMIOSRV_LIBRARY_UI=true
STREMIOSRV_LIBRARY_ALLOW_HTTP=false
STREMIOSRV_LIBRARY_OWNER=
# Empty = built-in private-network ranges. Do not place a personal account here
# unless this installation intentionally requires one.
STREMIOSRV_LIBRARY_ADDON_ALLOW=

# -----------------------------------------------------------------------------
# GPU / transcoding
# -----------------------------------------------------------------------------
# start.sh auto-detects VAAPI/NVIDIA and overrides the safe CPU baseline below.
# Valid launcher values: auto, vaapi, nvidia, cpu
# On dual-GPU hosts, auto may expose both VAAPI and NVIDIA so WebAdmin can
# runtime-test each family; only verified profiles become selectable.
GPU_BACKEND=auto
# Leave blank when using start.sh: it detects and exports a usable /dev/dri/renderD*.
# If compose.vaapi.yaml is invoked directly, VAAPI_DEVICE must be set explicitly.
VAAPI_DEVICE=
# libva auto-detects the driver by default. To force a known host-specific
# override, uncomment and set a non-empty value, for example:
# LIBVA_DRIVER_NAME=iHD

# Safe fallback for hosts with no compatible GPU/runtime.
TRANSCODING_MODE=auto
TRANSCODING_HWACCEL=cpu
TRANSCODING_VIDEO_CODEC=libx264
TRANSCODING_VIDEO_QUALITY=22
TRANSCODING_AUDIO_CODEC=aac
TRANSCODING_AUDIO_BITRATE=192k
TRANSCODING_COPY_VIDEO=true
TRANSCODING_COPY_AUDIO=true
TRANSCODING_DIRECT_VIDEO_CODECS=h264
TRANSCODING_DIRECT_AUDIO_CODECS=aac,mp3,ac3
TRANSCODING_FALLBACK_CODEC=libx264
TRANSCODING_HW_DECODE=false

# Optional VAAPI tuning. Configure only after validating the local GPU/driver.
# VAAPI_LOW_POWER=1
# VAAPI_RC_MODE=CQP
# VAAPI_QP=23

# Generic lifecycle defaults. Tune only after observing the local workload.
STREMIOSRV_TRANSCODE_IDLE_TIMEOUT=300
STREMIOSRV_TRANSCODE_GC_INTERVAL=60
STREMIOSRV_TRANSCODE_GC_MAX_AGE=600

# -----------------------------------------------------------------------------
# VPN / Gluetun
# -----------------------------------------------------------------------------
# Credentials, certificates and private keys are created/imported in WebAdmin -> VPN.
# Default covers common 192.168.x.x LANs plus the platform internal network.
# If the host LAN uses another range (for example 10.x or 172.16/12), set the exact
# LAN subnet(s) here. Avoid unnecessarily broad ranges that overlap the VPN tunnel.
VPN_LAN_CIDRS=192.168.0.0/16,172.30.0.0/24
# Public resolver used by the gateway when VPN is OFF.
STREMIO_DIRECT_DNS_UPSTREAM=1.1.1.1

# -----------------------------------------------------------------------------
# Pi-hole
# -----------------------------------------------------------------------------
# Strongly recommended: set a unique local admin password before first start.
PIHOLE_PASSWORD=
# Leave binding addresses blank when using start.sh; they inherit the detected host IP.
PIHOLE_WEB_BIND_IP=
PIHOLE_WEB_PORT=8053
PIHOLE_DNS_BIND_IP=
PIHOLE_DNS_PORT=53
